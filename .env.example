# ==============================================================
# Sai Sarathi Travels - Firebase Firestore Configuration
# ==============================================================
# To enable global reviews across all devices (saisarthi.in & localhost):
# 1. Visit https://console.firebase.google.com/ (100% Free - Spark Plan, 50k reads/day)
# 2. Create a new project (e.g. "saisarthi-reviews")
# 3. In the left menu: Click "Build" -> "Firestore Database" -> "Create database"
# 4. In "Project Settings" (gear icon) -> Scroll down to "Your apps" -> Add Web App (</>)
# 5. Copy your Firebase keys below and paste them into .env

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
