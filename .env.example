# ==============================================================
# Sai Sarathi Travels - Backend Server & Database Configuration
# ==============================================================
# Backend Server Port (defaults to 5000)
BACKEND_PORT=5000

# SQLite Database File Path (defaults to server/data/reviews.db)
DATABASE_PATH=server/data/reviews.db

# Client origin for CORS (e.g. http://localhost:8443, https://saisarthi.in, or * for all)
CLIENT_URL=*

# Frontend API URL (leave empty when using Vite dev proxy or same-domain hosting)
VITE_API_URL=
